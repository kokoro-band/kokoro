{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reply": { "type": "string", "maxLength": 500 },
    "commands": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "enum": ["ADD", "MOVE", "ROTATE", "REMOVE", "CLEAR"] },
          "catalogId": { "type": ["string", "null"], "maxLength": 100 },
          "targetQuery": { "type": ["string", "null"], "maxLength": 100 },
          "anchorQuery": { "type": ["string", "null"], "maxLength": 100 },
          "placement": { "type": "string", "enum": ["AUTO", "CENTER", "LEFT", "RIGHT", "FRONT", "BACK", "NEAR_WINDOW", "NEAR_DOOR", "OFFSET_LEFT", "OFFSET_RIGHT", "OFFSET_FRONT", "OFFSET_BACK"] },
          "distanceM": { "type": "number", "minimum": 0, "maximum": 5 },
          "rotation": { "type": "integer", "minimum": -360, "maximum": 360 },
          "count": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "required": ["action", "catalogId", "targetQuery", "anchorQuery", "placement", "distanceM", "rotation", "count"]
      }
    }
  },
  "required": ["reply", "commands"]
}
