VITE_API_MODE=server
# vp dev에서만 loopback HTTP를 사용할 수 있습니다.
VITE_API_BASE_URL=http://localhost:8080/api
# 배포할 때는 HTTPS API 주소 또는 같은 출처 프록시 경로 /api로 바꾸세요.
# 환경 변수는 빌드에 포함되므로 비밀값을 넣지 마세요.
# 시연 배포에서 로그인 화면을 먼저 보여 주려면 demo로 설정하세요. 백엔드는 demo 프로파일이어야 합니다.
# VITE_AUTH_MODE=demo
# 로그인 화면의 입력 칸에 회색 안내 글씨로 보여 줄 공개 체험 계정입니다(입력된 값이 아닙니다). 서버에도 같은 계정을 등록해야 로그인됩니다.
# VITE_DEMO_HINT_USER=test
# VITE_DEMO_HINT_PASSWORD=1234
