# 이 파일을 .env.local로 복사해 값을 바꾸세요. .env.local은 커밋되지 않습니다.
# 배포 대상별 값은 .env.<이름>.local에 두고 vp run build --mode <이름>으로 빌드합니다.
# 환경 변수는 빌드에 포함되므로 비밀값을 넣지 마세요.

# local은 서버 없이 브라우저에 저장하고 server는 Spring API에 연결합니다.
# 비워 두면 local입니다. 다른 값은 vp dev와 빌드에서 오류로 멈춥니다.
VITE_API_MODE=server

# vp dev에서만 loopback HTTP를 사용할 수 있습니다.
# 서버 모드 빌드는 HTTPS API 주소 또는 같은 출처 프록시 경로 /api가 없으면 실패합니다.
VITE_API_BASE_URL=http://localhost:8080/api

# 사이트가 도메인 바로 아래가 아닐 때만 설정합니다. 예: GitHub Pages의 /kokoro/
# VITE_BASE_PATH=/kokoro/
